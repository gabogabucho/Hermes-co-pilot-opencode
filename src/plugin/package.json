{
  "name": "@hermes-ai/opencode-copilot-plugin",
  "version": "0.1.0",
  "description": "Connect your Hermes Agent as a coding provider in OpenCode",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabogabucho/Hermes-co-pilot-opencode"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun run build && echo 'Built. Copy dist/ to your OpenCode plugins dir.'",
    "types": "tsc",
    "format": "biome check --write --unsafe",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@opencode-ai/plugin": "^1.4.3",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.0",
    "typescript": "^5.8.0"
  }
}
